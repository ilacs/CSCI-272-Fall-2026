#include <iostream>
#include <string>
using namespace std;

// Define a new class called Car
class Car
{
public:

    // Data members These variables describe the state of a Car object.
    string brand;
    string model;
    string color;
    int year = 0; // Initialize before any experiment reads this member.

    // Member function This function describes something a Car can do.
    void startEngine()
    {
        cout << "Engine started!" << endl;
    }
};

int main()
{
    // car1 is an OBJECT of the Car class.
    Car car1;
    Car car2;

    // Assign values to the object's data members.
    car1.brand = "Lexus";
    car1.model = "Polo";
    car1.year = 2012;
    car1.color = "Black";
    
    car2.brand = "Toyota";
    car2.model = "Highlander";
    car2.year = 2015;
    car2.color = "Grey";

    // Access data using the dot operator. 
    cout << "=== Car.1 ===" << endl;
    cout << "Brand: " << car1.brand << endl;
    cout << "Model: " << car1.model << endl;
    cout << "Year: " << car1.year << endl;
    cout << "Color: " << car1.color << endl;
    
    // Call a member function.
    car1.startEngine();
     cout << "=== Car.2 ===" << endl;
    cout << "Brand: " << car2.brand << endl;
    cout << "Model: " << car2.model << endl;
    cout << "Year: " << car2.year << endl;
    cout << "Color: " << car2.color << endl;
    
    car2.startEngine();
    
    return 0;
    
}

